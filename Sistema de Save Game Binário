#include <stdio.h>

typedef struct {
    char nome[50];
    int nivel;
    float vida, mana;
} Heroi;

int main() {
    int op;
    do {
        printf("1-Criar 2-Sair: ");
        scanf("%d", &op);
        if (op == 1) {
            Heroi h;
            printf("Nome Nivel Vida Mana: ");
            scanf("%s %d %f %f", h.nome, &h.nivel, &h.vida, &h.mana);
            FILE *f = fopen("savegame.sav", "ab");
            if (f) fwrite(&h, sizeof(Heroi), 1, f);
            fclose(f);
        }
    } while (op != 2);
    return 0;
}
