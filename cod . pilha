#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char nome[50];
    int custo_mana;
} Feitico;

typedef struct no {
    Feitico dado;
    struct no *prox;
} No;

typedef struct {
    No *topo;
} Pilha;

void inicializar(Pilha *p) {
    p->topo = NULL;
}

int vazia(Pilha *p) {
    return (p->topo == NULL);
}

void push(Pilha *p, Feitico f) {

    No *novo = (No*) malloc(sizeof(No));

    if(novo == NULL){
        printf("Erro de memoria!\n");
        return;
    }

    novo->dado = f;
    novo->prox = p->topo;
    p->topo = novo;

    printf("Feitico adicionado!\n");
}

Feitico pop(Pilha *p) {

    Feitico erro;
    erro.custo_mana = -1;
    strcpy(erro.nome, "");

    if(vazia(p)){
        printf("A pilha de comandos esta vazia!\n");
        return erro;
    }

    No *remover = p->topo;

    Feitico f = remover->dado;

    p->topo = remover->prox;

    free(remover);

    return f;
}

Feitico top(Pilha *p){

    Feitico erro;
    erro.custo_mana = -1;
    strcpy(erro.nome,"");

    if(vazia(p)){
        printf("A pilha de comandos esta vazia!\n");
        return erro;
    }

    return p->topo->dado;
}

void mostrar_pilha(Pilha *p){

    if(vazia(p)){
        printf("A pilha de comandos esta vazia.\n");
        return;
    }

    No *aux = p->topo;

    printf("\n=== PILHA DE COMANDOS ===\n");

    while(aux != NULL){

        printf("Feitico: %s | Mana: %d\n",
               aux->dado.nome,
               aux->dado.custo_mana);

        aux = aux->prox;
    }
}

void liberar_pilha(Pilha *p){

    while(!vazia(p)){
        pop(p);
    }
}

int main(){

    Pilha p;
    Feitico f;
    int opcao;

    inicializar(&p);

    do{

        printf("\n===== ARCANISTA =====\n");
        printf("1 - Adicionar feitico\n");
        printf("2 - Lancar proximo feitico\n");
        printf("3 - Mostrar pilha\n");
        printf("4 - Consultar proximo feitico (Top)\n");
        printf("5 - Verificar status da pilha\n");
        printf("6 - Sair\n");
        printf("Opcao: ");
        scanf("%d",&opcao);
        getchar();

        switch(opcao){

            case 1:

                printf("Nome do feitico: ");
                fgets(f.nome,50,stdin);
                f.nome[strcspn(f.nome,"\n")] = '\0';

                printf("Custo de mana: ");
                scanf("%d",&f.custo_mana);
                getchar();

                push(&p,f);

                break;

            case 2:

                f = pop(&p);

                if(f.custo_mana != -1){
                    printf("Feitico '%s' lancado com sucesso!\n",
                           f.nome);
                }

                break;

            case 3:

                mostrar_pilha(&p);

                break;

            case 4:

                f = top(&p);

                if(f.custo_mana != -1){
                    printf("\nProximo feitico:\n");
                    printf("Nome: %s\n",f.nome);
                    printf("Mana: %d\n",f.custo_mana);
                }

                break;

            case 5:

                if(vazia(&p))
                    printf("A pilha esta vazia.\n");
                else
                    printf("A pilha possui feiticos pendentes.\n");

                break;

            case 6:

                liberar_pilha(&p);
                printf("Sistema encerrado!\n");

                break;

            default:

                printf("Opcao invalida!\n");

        }

    }while(opcao!=6);

    return 0;
}
