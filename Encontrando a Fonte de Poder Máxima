#include <stdio.h>

int maxDC(int v[], int l, int r) {
    if (l == r) return v[l];
    int m = (l + r) / 2;
    int e = maxDC(v, l, m), d = maxDC(v, m + 1, r);
    return e > d ? e : d;
}

int main() {
    int n;
    scanf("%d", &n);
    int v[n];
    for (int i = 0; i < n; i++) scanf("%d", &v[i]);
    printf("%d\n", maxDC(v, 0, n - 1));
    return 0;
}
