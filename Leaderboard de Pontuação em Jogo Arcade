#include <stdio.h>

typedef struct {
    char nome[50];
    int pts;
} Player;

void insSortDesc(Player p[], int n) {
    for (int i = 1; i < n; i++) {
        Player chave = p[i];
        int j = i - 1;
        while (j >= 0 && p[j].pts < chave.pts) { p[j + 1] = p[j]; j--; }
        p[j + 1] = chave;
    }
}

int main() {
    int n;
    scanf("%d", &n);
    Player p[n];
    for (int i = 0; i < n; i++) scanf("%s %d", p[i].nome, &p[i].pts);
    insSortDesc(p, n);
    for (int i = 0; i < n; i++) printf("%d %s\n", p[i].pts, p[i].nome);
    return 0;
}
