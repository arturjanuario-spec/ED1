#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int id, perigo;
} Nave;

void merge(Nave v[], int l, int m, int r) {
    int n1 = m - l + 1, n2 = r - m;
    Nave *e = malloc(n1 * sizeof(Nave)), *d = malloc(n2 * sizeof(Nave));
    for (int i = 0; i < n1; i++) e[i] = v[l + i];
    for (int i = 0; i < n2; i++) d[i] = v[m + 1 + i];
    int i = 0, j = 0, k = l;
    while (i < n1 && j < n2) v[k++] = (e[i].perigo <= d[j].perigo) ? e[i++] : d[j++];
    while (i < n1) v[k++] = e[i++];
    while (j < n2) v[k++] = d[j++];
    free(e); free(d);
}

void mergeSort(Nave v[], int l, int r) {
    if (l < r) {
        int m = (l + r) / 2;
        mergeSort(v, l, m);
        mergeSort(v, m + 1, r);
        merge(v, l, m, r);
    }
}

int main() {
    int n;
    scanf("%d", &n);
    Nave naves[n];
    for (int i = 0; i < n; i++) scanf("%d %d", &naves[i].id, &naves[i].perigo);
    mergeSort(naves, 0, n - 1);
    for (int i = 0; i < n; i++) printf("%d%c", naves[i].id, i < n - 1 ? ' ' : '\n');
    return 0;
}
