#include <stdio.h>

typedef struct {
    char nome[50];
    int hp;
} Besta;

int main() {
    int n;
    scanf("%d", &n);
    Besta b[n];
    for (int i = 0; i < n; i++) scanf("%s %d", b[i].nome, &b[i].hp);
    int menor = 0;
    for (int i = 1; i < n; i++) if (b[i].hp < b[menor].hp) menor = i;
    printf("Alvo prioritario: %s (%d HP)\n", b[menor].nome, b[menor].hp);
    return 0;
}
