#include <stdio.h>

typedef struct {
    int id, str, agi, intel;
    char nome[50];
} Persona;

int main() {
    int n;
    scanf("%d", &n);
    Persona p[n];
    for (int i = 0; i < n; i++)
        scanf("%d %s %d %d %d", &p[i].id, p[i].nome, &p[i].str, &p[i].agi, &p[i].intel);
    int opt;
    do {
        scanf("%d", &opt);
        if (opt == 1) {
            int id;
            scanf("%d", &id);
            int achou = -1;
            for (int i = 0; i < n; i++)
                if (p[i].id == id) { achou = i; break; }
            if (achou != -1)
                printf("%s: %.2f\n", p[achou].nome, (p[achou].str + p[achou].agi + p[achou].intel) / 3.0);
            else printf("Personagem nao encontrado\n");
        }
    } while (opt != 2);
    return 0;
}
