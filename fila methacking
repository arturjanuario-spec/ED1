#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int id;
    char nome[50];
} Jogador;

typedef struct no {
    Jogador dado;
    struct no *prox;
} No;

typedef struct {
    No *inicio;
} Fila;

void inicializar(Fila *f) {
    f->inicio = NULL;
}

No* criarNo(Jogador j) {
    No *novo = (No*)malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro de memória!\n");
        exit(1);
    }

    novo->dado = j;
    novo->prox = NULL;

    return novo;
}

void enfileirar(Fila *f, Jogador j) {
    No *novo = criarNo(j);

    if (f->inicio == NULL) {
        f->inicio = novo;
    } else {
        No *atual = f->inicio;

        while (atual->prox != NULL) {
            atual = atual->prox;
        }

        atual->prox = novo;
    }

    printf("Jogador entrou na fila!\n");
}

void desenfileirar(Fila *f) {
    if (f->inicio == NULL) {
        printf("Não há jogadores na fila!\n");
        return;
    }

    No *remover = f->inicio;

    printf("Jogador %s (ID %d) entrou na partida!\n",
           remover->dado.nome,
           remover->dado.id);

    f->inicio = remover->prox;
    free(remover);
}

void mostrarFila(Fila *f) {
    No *atual = f->inicio;

    if (atual == NULL) {
        printf("\nFila vazia!\n");
        return;
    }

    printf("\n===== FILA DE MATCHMAKING =====\n");

    while (atual != NULL) {
        printf("ID: %d | Nome: %s\n",
               atual->dado.id,
               atual->dado.nome);

        atual = atual->prox;
    }
}

void liberar(Fila *f) {
    No *atual = f->inicio;

    while (atual != NULL) {
        No *temp = atual;
        atual = atual->prox;
        free(temp);
    }
}

int main() {
    Fila fila;
    Jogador j;
    int opcao;

    inicializar(&fila);

    do {
        printf("\n===== MENU =====\n");
        printf("1 - Adicionar jogador ao fim\n");
        printf("2 - Iniciar partida (remover do início)\n");
        printf("3 - Mostrar fila\n");
        printf("4 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {

            case 1:
                printf("ID: ");
                scanf("%d", &j.id);

                printf("Nome: ");
                scanf(" %[^\n]", j.nome);

                enfileirar(&fila, j);
                break;

            case 2:
                desenfileirar(&fila);
                break;

            case 3:
                mostrarFila(&fila);
                break;

            case 4:
                printf("Encerrando...\n");
                break;

            default:
                printf("Opção inválida!\n");
        }

    } while(opcao != 4);

    liberar(&fila);

    return 0;
}
