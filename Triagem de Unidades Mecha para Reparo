#include <stdio.h>

void particao(int n, int v[]) {
    int pivo = v[n - 1];
    int i = -1;  // índice da “região menor que o pivô”

    for (int j = 0; j < n - 1; j++) {
        if (v[j] < pivo) {
            i++;
            // troca v[i] com v[j]
            int temp = v[i];
            v[i] = v[j];
            v[j] = temp;
        }
    }

    int temp = v[i + 1];
    v[i + 1] = v[n - 1];
    v[n - 1] = temp;
}

int main() {
    int n;
    scanf("%d", &n);

    int v[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }

    particao(n, v);

    for (int i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }

    return 0;
}
