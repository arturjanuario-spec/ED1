#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void troca(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int particao(int v[], int inicio, int fim) {
    int randomIndex = inicio + rand() % (fim - inicio + 1);

    troca(&v[randomIndex], &v[fim]);

    int pivo = v[fim];
    int j = inicio - 1;

    for (int i = inicio; i < fim; i++) {
        if (v[i] <= pivo) {
            j++;
            troca(&v[j], &v[i]);
        }
    }

    troca(&v[j + 1], &v[fim]);
    return j + 1;
}

void quickSort(int v[], int inicio, int fim) {
    if (inicio < fim) {
        int p = particao(v, inicio, fim);

        quickSort(v, inicio, p - 1);
        quickSort(v, p + 1, fim);
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int v[n];

    srand(time(NULL));

    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }

    quickSort(v, 0, n - 1);

    for (int i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }

    return 0;
}
