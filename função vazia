#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    int id;
    char nickname[50];
} Jogador;

typedef struct no {
    Jogador dado;
    struct no *prox;
} No;

typedef struct {
    No *inicio;
    No *fim;
} Fila;

void inicializar(Fila *f) {
    f->inicio = NULL;
    f->fim = NULL;
}

int estaVazia(Fila *f) {
    return (f->inicio == NULL);
}

void inserir(Fila *f, Jogador j) {

    No *novo = (No*) malloc(sizeof(No));

    if (!novo) {
        printf("Erro de memoria!\n");
        return;
    }

    novo->dado = j;
    novo->prox = NULL;

    if (f->inicio == NULL) {
        f->inicio = novo;
        f->fim = novo;
    } else {
        f->fim->prox = novo;
        f->fim = novo;
    }
}

Jogador remover(Fila *f) {

    Jogador invalido;
    invalido.id = -1;
    strcpy(invalido.nickname, "");

    if (estaVazia(f)) {
        printf("Fila vazia! Nao ha jogadores para remover.\n");
        return invalido;
    }

    No *remover = f->inicio;
    Jogador j = remover->dado;

    f->inicio = f->inicio->prox;

    if (f->inicio == NULL) {
        f->fim = NULL;
    }

    free(remover);

    return j;
}

void mostrar(Fila *f) {

    if (estaVazia(f)) {
        printf("Fila vazia.\n");
        return;
    }

    No *aux = f->inicio;

    printf("\n=== FILA ===\n");

    while (aux != NULL) {
        printf("ID: %d | Nick: %s\n",
               aux->dado.id,
               aux->dado.nickname);
        aux = aux->prox;
    }
}

int main() {

    Fila f;
    inicializar(&f);

    int opcao;
    Jogador j;

    do {

        printf("\n===== MATCHMAKING =====\n");
        printf("1 - Inserir jogador\n");
        printf("2 - Remover jogador\n");
        printf("3 - Mostrar fila\n");
        printf("4 - Verificar se a fila esta vazia\n");
        printf("5 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);
        getchar();

        switch(opcao) {

            case 1:

                printf("ID: ");
                scanf("%d", &j.id);
                getchar();

                printf("Nickname: ");
                fgets(j.nickname, 50, stdin);
                j.nickname[strcspn(j.nickname, "\n")] = '\0';

                inserir(&f, j);

                break;

            case 2: {

                Jogador r = remover(&f);

                if (r.id != -1) {
                    printf("Jogador %s (ID: %d) saiu da fila!\n",
                           r.nickname, r.id);
                }

                break;
            }

            case 3:

                mostrar(&f);

                break;

            case 4:

                if (estaVazia(&f)) {
                    printf("SIM, a fila esta vazia.\n");
                } else {
                    printf("NAO, a fila contem jogadores.\n");
                }

                break;

            case 5:

                printf("Saindo...\n");
                break;

            default:

                printf("Opcao invalida!\n");
        }

    } while (opcao != 5);

    return 0;
}
