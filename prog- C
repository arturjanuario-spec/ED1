#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int id;
    char nome[50];
} Aventureiro;

typedef struct no {
    Aventureiro dado;
    struct no *prox;
} No;

typedef struct {
    No *inicio;
} Lista;

void inicializar(Lista *lista) {
    lista->inicio = NULL;
}

void adicionarAventureiro(Lista *lista, Aventureiro av) {
    No *novo = (No *)malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro de memória!\n");
        return;
    }

    novo->dado = av;
    novo->prox = lista->inicio;
    lista->inicio = novo;

    printf("Aventureiro adicionado!\n");
}

void mostrarGrupo(Lista *lista) {
    No *atual = lista->inicio;

    if (atual == NULL) {
        printf("\nGrupo vazio!\n");
        return;
    }

    printf("\n===== GRUPO DE AVENTUREIROS =====\n");

    while (atual != NULL) {
        printf("ID: %d | Nome: %s\n", atual->dado.id, atual->dado.nome);
        atual = atual->prox;
    }
}

void liberar(Lista *lista) {
    No *atual = lista->inicio;

    while (atual != NULL) {
        No *temp = atual;
        atual = atual->prox;
        free(temp);
    }
}

int main() {
    Lista grupo;
    Aventureiro av;
    int opcao;

    inicializar(&grupo);

    do {
        printf("\n===== MENU =====\n");
        printf("1 - Adicionar Aventureiro\n");
        printf("2 - Mostrar Grupo\n");
        printf("3 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                printf("ID do aventureiro: ");
                scanf("%d", &av.id);

                printf("Nome do aventureiro: ");
                scanf(" %[^\n]", av.nome);

                adicionarAventureiro(&grupo, av);
                break;

            case 2:
                mostrarGrupo(&grupo);
                break;

            case 3:
                printf("Encerrando...\n");
                break;

            default:
                printf("Opção inválida!\n");
        }

    } while(opcao != 3);

    liberar(&grupo);

    return 0;
}
