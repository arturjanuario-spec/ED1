#include <stdio.h>

void selSort(int v[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int m = i;
        for (int j = i + 1; j < n; j++) if (v[j] < v[m]) m = j;
        if (m != i) { int t = v[i]; v[i] = v[m]; v[m] = t; }
    }
}

int main() {
    int n;
    scanf("%d", &n);
    int v[n];
    for (int i = 0; i < n; i++) scanf("%d", &v[i]);
    selSort(v, n);
    for (int i = 0; i < n; i++) printf("%d%c", v[i], i < n - 1 ? ' ' : '\n');
    return 0;
}
