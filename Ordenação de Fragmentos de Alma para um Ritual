#include <stdio.h>

void insSort(int v[], int n) {
    for (int i = 1; i < n; i++) {
        int chave = v[i], j = i - 1;
        while (j >= 0 && v[j] > chave) { v[j + 1] = v[j]; j--; }
        v[j + 1] = chave;
    }
}

int main() {
    int n;
    scanf("%d", &n);
    int v[n];
    for (int i = 0; i < n; i++) scanf("%d", &v[i]);
    insSort(v, n);
    for (int i = 0; i < n; i++) printf("%d%c", v[i], i < n - 1 ? ' ' : '\n');
    return 0;
}
