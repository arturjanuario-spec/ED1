#include <stdio.h>

int main() {
    int n, m;
    scanf("%d", &n);
    int a[n];
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);
    scanf("%d", &m);
    int b[m];
    for (int i = 0; i < m; i++) scanf("%d", &b[i]);
    int total = n + m, res[total], i = 0, j = 0, k = 0;
    while (i < n && j < m) res[k++] = (a[i] <= b[j]) ? a[i++] : b[j++];
    while (i < n) res[k++] = a[i++];
    while (j < m) res[k++] = b[j++];
    for (int i = 0; i < total; i++) printf("%d%c", res[i], i < total - 1 ? ' ' : '\n');
    return 0;
}
