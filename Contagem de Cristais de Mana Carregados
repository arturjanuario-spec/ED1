#include <stdio.h>

int contarPos(int *v, int n, int i) {
    if (i == n) return 0;
    return (v[i] > 0 ? 1 : 0) + contarPos(v, n, i + 1);
}

int main() {
    int n;
    scanf("%d", &n);
    int v[n];
    for (int i = 0; i < n; i++) scanf("%d", &v[i]);
    printf("%d\n", contarPos(v, n, 0));
    return 0;
}

