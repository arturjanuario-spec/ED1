Lista criar_lista(int n) {
    Lista nova;
    nova.inicio = NULL;

    Inimigo i;

    for (int j = 0; j < n; j++) {
        printf("ID do inimigo %d: ", j + 1);
        scanf("%d", &i.id);

        printf("Tipo do inimigo %d: ", j + 1);
        scanf(" %[^\n]", i.tipo);

        inserir_fim(&nova, i);
    }

    return nova;
}
