#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char nome[50];
    int kills;
} Guerreiro;

void selSortDesc(Guerreiro g[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int m = i;
        for (int j = i + 1; j < n; j++) if (g[j].kills > g[m].kills) m = j;
        if (m != i) { Guerreiro t = g[i]; g[i] = g[m]; g[m] = t; }
    }
}

int main() {
    int n;
    scanf("%d", &n);
    Guerreiro *g = malloc(n * sizeof(Guerreiro));
    for (int i = 0; i < n; i++) scanf("%s %d", g[i].nome, &g[i].kills);
    selSortDesc(g, n);
    for (int i = 0; i < n; i++) printf("%s %d\n", g[i].nome, g[i].kills);
    free(g);
    return 0;
}
