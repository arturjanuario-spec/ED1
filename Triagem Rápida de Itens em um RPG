#include <stdio.h>

void particao(int n, int v[]) {
    int s[n];
    int pivô = v[n - 1];

    int inicio = 0;
    int fim = n - 1;

    for (int i = 0; i < n; i++) {
        if (v[i] <= pivô) {
            s[inicio] = v[i];
            inicio++;
        } else {
            s[fim] = v[i];
            fim--;
        }
    }

    // Copia de volta para o vetor original
    for (int i = 0; i < n; i++) {
        v[i] = s[i];
    }
}

int main() {
    int n;

    scanf("%d", &n);

    int v[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }

    particao(n, v);

    for (int i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }

    return 0;
}
