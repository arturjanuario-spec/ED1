#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    int id;
    char nome[50];
} Mercenario;

typedef struct no {
    Mercenario dado;
    struct no *prox;
} No;

typedef struct {
    No *inicio;
} Lista;

void inicializar(Lista *l) {
    l->inicio = NULL;
}

No* criarNo(Mercenario m) {
    No *novo = (No*)malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro de memória!\n");
        exit(1);
    }

    novo->dado = m;
    novo->prox = NULL;

    return novo;
}

void contratar(Lista *l, Mercenario m) {
    No *novo = criarNo(m);

    if (l->inicio == NULL) {
        l->inicio = novo;
        return;
    }

    No *atual = l->inicio;

    while (atual->prox != NULL) {
        atual = atual->prox;
    }

    atual->prox = novo;
}

void exibir(Lista *l) {
    No *atual = l->inicio;

    if (atual == NULL) {
        printf("\nNenhum mercenário na companhia!\n");
        return;
    }

    printf("\n===== COMPANHIA =====\n");

    while (atual != NULL) {
        printf("ID: %d | Nome: %s\n",
               atual->dado.id,
               atual->dado.nome);

        atual = atual->prox;
    }
}

void demitir_todos_mercenarios(Lista *l) {

    No *atual = l->inicio;

    if (atual == NULL) {
        printf("A companhia já está vazia!\n");
        return;
    }

    while (atual != NULL) {
        No *temp = atual;
        atual = atual->prox;
        free(temp);
    }

    l->inicio = NULL;

    printf("Todos os mercenários foram demitidos!\n");
}

int main() {
    Lista lista;
    Mercenario m;
    int opcao;

    inicializar(&lista);

    do {
        printf("\n===== MENU =====\n");
        printf("1 - Contratar mercenário\n");
        printf("2 - Exibir companhia\n");
        printf("3 - Declarar falência\n");
        printf("4 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {

            case 1:
                printf("ID: ");
                scanf("%d", &m.id);

                printf("Nome: ");
                scanf(" %[^\n]", m.nome);

                contratar(&lista, m);
                break;

            case 2:
                exibir(&lista);
                break;

            case 3:
                demitir_todos_mercenarios(&lista);
                exibir(&lista); // confirmação de que está vazia
                break;

            case 4:
                printf("Encerrando...\n");
                break;

            default:
                printf("Opção inválida!\n");
        }

    } while(opcao != 4);

    demitir_todos_mercenarios(&lista);

    return 0;
}
