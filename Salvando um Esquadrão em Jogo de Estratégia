#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char nome[50];
    int hp, atk;
} Unidade;

int main() {
    int n;
    scanf("%d", &n);
    Unidade *u = malloc(n * sizeof(Unidade));
    for (int i = 0; i < n; i++)
        scanf("%s %d %d", u[i].nome, &u[i].hp, &u[i].atk);
    FILE *f = fopen("squad.dat", "wb");
    if (f) fwrite(u, sizeof(Unidade), n, f);
    fclose(f);
    int melhor = 0;
    for (int i = 1; i < n; i++)
        if (u[i].atk > u[melhor].atk) melhor = i;
    printf("Maior ataque: %s\n", u[melhor].nome);
    free(u);
    return 0;
}
