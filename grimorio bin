#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char nome[50];
    int custo_mana;
} Feitico;

typedef struct no {
    Feitico dado;
    struct no *prox;
} No;

typedef struct {
    No *topo;
} Pilha;

void inicializar(Pilha *p) {
    p->topo = NULL;
}

int vazia(Pilha *p) {
    return (p->topo == NULL);
}

void push(Pilha *p, Feitico f) {
    No *novo = (No*) malloc(sizeof(No));

    if (!novo) {
        printf("Erro de memoria!\n");
        return;
    }

    novo->dado = f;
    novo->prox = p->topo;
    p->topo = novo;
}

Feitico pop(Pilha *p) {

    Feitico erro;
    erro.custo_mana = -1;
    strcpy(erro.nome, "");

    if (vazia(p)) {
        printf("Pilha vazia!\n");
        return erro;
    }

    No *remover = p->topo;
    Feitico f = remover->dado;

    p->topo = remover->prox;
    free(remover);

    return f;
}

void mostrar_pilha(Pilha *p) {

    if (vazia(p)) {
        printf("Pilha vazia.\n");
        return;
    }

    No *aux = p->topo;

    printf("\n=== PILHA ===\n");

    while (aux != NULL) {
        printf("Feitico: %s | Mana: %d\n",
               aux->dado.nome,
               aux->dado.custo_mana);

        aux = aux->prox;
    }
}

void salvar_pilha_em_arquivo(Pilha *p, const char *nome_arquivo) {

    FILE *file = fopen(nome_arquivo, "wb");

    if (file == NULL) {
        printf("Erro ao abrir o arquivo!\n");
        return;
    }

    No *aux = p->topo;

    while (aux != NULL) {
        fwrite(&(aux->dado), sizeof(Feitico), 1, file);
        aux = aux->prox;
    }

    fclose(file);

    printf("Pilha salva com sucesso no arquivo '%s'!\n", nome_arquivo);
}

int main() {

    Pilha p;
    inicializar(&p);

    Feitico f;
    int opcao;

    do {

        printf("\n===== ARCANISTA =====\n");
        printf("1 - Adicionar feitico\n");
        printf("2 - Mostrar pilha\n");
        printf("3 - Lançar feitico (pop)\n");
        printf("4 - Salvar sequencia no grimorio\n");
        printf("5 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);
        getchar();

        switch(opcao) {

            case 1:

                printf("Nome do feitico: ");
                fgets(f.nome, 50, stdin);
                f.nome[strcspn(f.nome, "\n")] = '\0';

                printf("Custo de mana: ");
                scanf("%d", &f.custo_mana);
                getchar();

                push(&p, f);

                break;

            case 2:

                mostrar_pilha(&p);

                break;

            case 3:

                f = pop(&p);

                if (f.custo_mana != -1) {
                    printf("Feitico '%s' lançado!\n", f.nome);
                }

                break;

            case 4:

                salvar_pilha_em_arquivo(&p, "grimorio.bin");

                break;

            case 5:

                printf("Encerrando...\n");

                break;

            default:

                printf("Opcao invalida!\n");

        }

    } while(opcao != 5);

    return 0;
}
