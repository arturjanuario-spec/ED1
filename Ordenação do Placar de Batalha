#include <stdio.h>

void bubbleDesc(int v[], int n) {
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - i - 1; j++)
            if (v[j] < v[j + 1]) { int t = v[j]; v[j] = v[j + 1]; v[j + 1] = t; }
}

int main() {
    int n;
    scanf("%d", &n);
    int v[n];
    for (int i = 0; i < n; i++) scanf("%d", &v[i]);
    bubbleDesc(v, n);
    for (int i = 0; i < n; i++) printf("%d%c", v[i], i < n - 1 ? ' ' : '\n');
    return 0;
}
